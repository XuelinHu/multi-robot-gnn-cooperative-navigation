<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="v2-en" name="V2-English"><mxGraphModel dx="1500" dy="400" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="400"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="GNN-Based Multi-Robot Cooperative Path Planning and Collision Avoidance" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="300" y="15" width="900" height="35" as="geometry"/></mxCell><mxCell id="net" value="Shared GNN policy: node encoder → message passing 1 (neighbor aggregation) → message passing 2 (node embedding update) → message passing 3 (shared graph representation) → shared policy head (velocity action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaff;strokeColor=#6c8ebf;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="130" width="700" height="145" as="geometry"/></mxCell><mxCell id="safety" value="Safety filter&#xa;Collision check&#xa;Velocity clipping&#xa;ORCA-style correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2c6;strokeColor=#c9a227;fontSize=15" vertex="1" parent="1"><mxGeometry x="790" y="145" width="190" height="110" as="geometry"/></mxCell><mxCell id="cmd" value="Velocity commands&#xa;Safe velocity vᵢˢᵃᶠᵉ = (vₓ, vᵧ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce5;strokeColor=#70ad7b;fontSize=15" vertex="1" parent="1"><mxGeometry x="1040" y="145" width="180" height="110" as="geometry"/></mxCell><mxCell id="env" value="Multi-robot environment&#xa;Physics rollout, obstacles, goals, and rewards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8e3f1;strokeColor=#b478a0;fontSize=15" vertex="1" parent="1"><mxGeometry x="1280" y="145" width="190" height="110" as="geometry"/></mxCell><mxCell id="a" value="Proposed actions" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="net" target="safety"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b" value="Safe commands" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="safety" target="cmd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c" value="Execute" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="cmd" target="env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d" value="Next observations Xₜ, Aₜ" style="endArrow=block;dashed=1;html=1;strokeWidth=2" edge="1" parent="1" source="env" target="net"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1375" y="330"/><mxPoint x="380" y="330"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
