<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="v3-zh" name="V3-中文"><mxGraphModel dx="1600" dy="400" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="420"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="基于图神经网络的多机器人协同路径规划与避碰" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="400" y="10" width="800" height="35" as="geometry"/></mxCell><mxCell id="obs" value="多机器人观测&#xa;机器人状态：pᵢ、vᵢ&#xa;目标向量：gᵢ&#xa;局部障碍物：oᵢ&#xa;邻居相对状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2ff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="25" y="130" width="205" height="150" as="geometry"/></mxCell><mxCell id="graph" value="动态图构建&#xa;节点 = 机器人&#xa;边：距离 ≤ R&#xa;节点特征 Xₜ&#xa;邻接矩阵 Aₜ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9f7ee;strokeColor=#5b9b91;fontSize=15" vertex="1" parent="1"><mxGeometry x="285" y="130" width="205" height="150" as="geometry"/></mxCell><mxCell id="net" value="共享 GNN 策略网络&#xa;节点编码器 MLP(Xₜ)&#xa;消息传递 1：邻居聚合&#xa;消息传递 2：嵌入更新&#xa;消息传递 3：共享图表示&#xa;共享策略头：速度动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="550" y="100" width="310" height="210" as="geometry"/></mxCell><mxCell id="safe" value="安全过滤器&#xa;碰撞检查&#xa;速度裁剪&#xa;ORCA 风格修正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2c6;strokeColor=#c9a227;fontSize=15" vertex="1" parent="1"><mxGeometry x="920" y="140" width="180" height="130" as="geometry"/></mxCell><mxCell id="cmd" value="速度指令&#xa;每个机器人的安全速度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce5;strokeColor=#70ad7b;fontSize=15" vertex="1" parent="1"><mxGeometry x="1150" y="145" width="180" height="120" as="geometry"/></mxCell><mxCell id="env" value="多机器人环境&#xa;物理执行、障碍物与目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8e3f1;strokeColor=#b478a0;fontSize=15" vertex="1" parent="1"><mxGeometry x="1380" y="145" width="190" height="120" as="geometry"/></mxCell><mxCell id="a" value="构建图" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="obs" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b" value="Xₜ, Aₜ" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="graph" target="net"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c" value="候选动作" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="net" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d" value="安全速度" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="safe" target="cmd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e" value="执行" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="cmd" target="env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="下一时刻观测" style="endArrow=block;dashed=1;html=1;strokeWidth=2" edge="1" parent="1" source="env" target="obs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="350"/><mxPoint x="125" y="350"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
