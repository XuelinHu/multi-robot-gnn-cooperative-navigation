<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="arch-zh" name="主版-中文"><mxGraphModel dx="1100" dy="750" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="基于图神经网络的多机器人协同路径规划与避碰" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="150" y="20" width="800" height="40" as="geometry"/></mxCell><mxCell id="obs" value="多机器人观测&#xa;机器人状态：位置 pᵢ、速度 vᵢ&#xa;目标向量 gᵢ、局部障碍物 oᵢ&#xa;邻居机器人相对状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2ff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="35" y="170" width="205" height="145" as="geometry"/></mxCell><mxCell id="graph" value="动态图构建&#xa;节点：机器人&#xa;边：距离 ≤ 通信半径 R&#xa;节点特征 Xₜ；邻接矩阵 Aₜ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9f7ee;strokeColor=#5b9b91;fontSize=15" vertex="1" parent="1"><mxGeometry x="290" y="170" width="215" height="145" as="geometry"/></mxCell><mxCell id="gnn" value="共享图神经网络策略&#xa;节点编码器：MLP(Xₜ)&#xa;消息传递层 1：邻居信息聚合&#xa;消息传递层 2：节点嵌入更新&#xa;消息传递层 3：共享图表示&#xa;共享策略头：输出速度动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="555" y="130" width="265" height="225" as="geometry"/></mxCell><mxCell id="safe" value="安全过滤器&#xa;碰撞检查&#xa;速度裁剪&#xa;ORCA 风格修正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2c6;strokeColor=#c9a227;fontSize=15" vertex="1" parent="1"><mxGeometry x="865" y="165" width="190" height="150" as="geometry"/></mxCell><mxCell id="env" value="多机器人环境&#xa;物理步进、障碍物与目标&#xa;奖励和性能指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8e3f1;strokeColor=#b478a0;fontSize=15" vertex="1" parent="1"><mxGeometry x="555" y="475" width="265" height="110" as="geometry"/></mxCell><mxCell id="e1" value="观测 Xₜ" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="obs" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Xₜ, Aₜ" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="graph" target="gnn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="候选动作" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="gnn" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="安全速度指令" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="safe" target="env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="下一时刻状态" style="endArrow=block;dashed=1;html=1;strokeWidth=2" edge="1" parent="1" source="env" target="obs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="530"/><mxPoint x="135" y="530"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
