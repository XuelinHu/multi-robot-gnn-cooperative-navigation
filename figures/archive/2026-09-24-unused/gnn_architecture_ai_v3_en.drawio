<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="v3-en" name="V3-English"><mxGraphModel dx="1600" dy="400" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="420"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="GNN-Based Multi-Robot Cooperative Path Planning and Collision Avoidance" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="400" y="10" width="800" height="35" as="geometry"/></mxCell><mxCell id="obs" value="Multi-robot observations&#xa;Robot state: pᵢ, vᵢ&#xa;Goal vector: gᵢ&#xa;Local obstacles: oᵢ&#xa;Neighbor relative states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2ff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="25" y="130" width="205" height="150" as="geometry"/></mxCell><mxCell id="graph" value="Dynamic graph construction&#xa;Nodes = robots&#xa;Edges: distance ≤ R&#xa;Node features Xₜ&#xa;Adjacency Aₜ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9f7ee;strokeColor=#5b9b91;fontSize=15" vertex="1" parent="1"><mxGeometry x="285" y="130" width="205" height="150" as="geometry"/></mxCell><mxCell id="net" value="Shared GNN policy network&#xa;Node encoder MLP(Xₜ)&#xa;Message passing 1: neighbor aggregation&#xa;Message passing 2: embedding update&#xa;Message passing 3: shared graph representation&#xa;Shared policy head: velocity action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="550" y="100" width="310" height="210" as="geometry"/></mxCell><mxCell id="safe" value="Safety filter&#xa;Collision check&#xa;Velocity clipping&#xa;ORCA-style correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2c6;strokeColor=#c9a227;fontSize=15" vertex="1" parent="1"><mxGeometry x="920" y="140" width="180" height="130" as="geometry"/></mxCell><mxCell id="cmd" value="Velocity commands&#xa;Safe velocity per robot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce5;strokeColor=#70ad7b;fontSize=15" vertex="1" parent="1"><mxGeometry x="1150" y="145" width="180" height="120" as="geometry"/></mxCell><mxCell id="env" value="Multi-robot environment&#xa;Physics execution, obstacles, and goals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8e3f1;strokeColor=#b478a0;fontSize=15" vertex="1" parent="1"><mxGeometry x="1380" y="145" width="190" height="120" as="geometry"/></mxCell><mxCell id="a" value="Construct graph" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="obs" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b" value="Xₜ, Aₜ" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="graph" target="net"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c" value="Proposed actions" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="net" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d" value="Safe velocities" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="safe" target="cmd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e" value="Execute" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="cmd" target="env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f" value="Next observations" style="endArrow=block;dashed=1;html=1;strokeWidth=2" edge="1" parent="1" source="env" target="obs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="350"/><mxPoint x="125" y="350"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
