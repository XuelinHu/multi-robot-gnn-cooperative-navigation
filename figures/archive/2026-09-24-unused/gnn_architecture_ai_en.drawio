<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="arch-en" name="Main-English"><mxGraphModel dx="1100" dy="750" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="GNN-Based Multi-Robot Cooperative Path Planning and Collision Avoidance" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1" vertex="1" parent="1"><mxGeometry x="150" y="20" width="800" height="40" as="geometry"/></mxCell><mxCell id="obs" value="Multi-robot observations&#xa;Robot state: position pᵢ, velocity vᵢ&#xa;Goal vector gᵢ and local obstacles oᵢ&#xa;Relative states of neighboring robots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff2ff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="35" y="170" width="205" height="145" as="geometry"/></mxCell><mxCell id="graph" value="Dynamic graph construction&#xa;Nodes: robots&#xa;Edges: distance ≤ communication radius R&#xa;Node features Xₜ; adjacency Aₜ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c9f7ee;strokeColor=#5b9b91;fontSize=15" vertex="1" parent="1"><mxGeometry x="290" y="170" width="215" height="145" as="geometry"/></mxCell><mxCell id="gnn" value="Shared GNN policy&#xa;Node encoder: MLP(Xₜ)&#xa;Message passing 1: neighbor aggregation&#xa;Message passing 2: node embedding update&#xa;Message passing 3: shared graph representation&#xa;Shared policy head: velocity action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eaff;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="555" y="130" width="265" height="225" as="geometry"/></mxCell><mxCell id="safe" value="Safety filter&#xa;Collision check&#xa;Velocity clipping&#xa;ORCA-style correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2c6;strokeColor=#c9a227;fontSize=15" vertex="1" parent="1"><mxGeometry x="865" y="165" width="190" height="150" as="geometry"/></mxCell><mxCell id="env" value="Multi-robot environment&#xa;Physics rollout, obstacles, and goals&#xa;Reward and performance metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8e3f1;strokeColor=#b478a0;fontSize=15" vertex="1" parent="1"><mxGeometry x="555" y="475" width="265" height="110" as="geometry"/></mxCell><mxCell id="e1" value="Observation Xₜ" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="obs" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Xₜ, Aₜ" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="graph" target="gnn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Proposed actions" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="gnn" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Safe velocity commands" style="endArrow=block;html=1;strokeWidth=2" edge="1" parent="1" source="safe" target="env"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Next state" style="endArrow=block;dashed=1;html=1;strokeWidth=2" edge="1" parent="1" source="env" target="obs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="530"/><mxPoint x="135" y="530"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
